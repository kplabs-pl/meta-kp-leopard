From da9a994926436a568edc47a85c9811dd6552a089 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Pawe=C5=82=20Klisz?= <pklisz@kplabs.pl>
Date: Tue, 19 Aug 2025 16:20:32 +0200
Subject: [PATCH] Add support for SI5338 clock generator

---
 lib/sw_apps/zynqmp_fsbl/src/xfsbl_main.c | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/lib/sw_apps/zynqmp_fsbl/src/xfsbl_main.c b/lib/sw_apps/zynqmp_fsbl/src/xfsbl_main.c
index abf9b72f8e..089af77c27 100644
--- a/lib/sw_apps/zynqmp_fsbl/src/xfsbl_main.c
+++ b/lib/sw_apps/zynqmp_fsbl/src/xfsbl_main.c
@@ -36,6 +36,9 @@
 #include "xfsbl_main.h"
 #include "bspconfig.h"
 
+#include "kp_zynqI2C.h"
+#include "kp_clockGenerator.h"
+
 /************************** Constant Definitions *****************************/
 
 /**************************** Type Definitions *******************************/
@@ -110,6 +113,26 @@ int main(void )
 					 * Initialize the global timer and get the value
 					 */
 
+					/** Initialize clock generator for Zynq peripherals */
+					if (zynqI2C_init() != XST_SUCCESS) {
+						xil_printf("[SI5338] Failed to initialize I2C\n\r");
+						break;
+					}
+					xil_printf("[SI5338] I2C initialized\n\r");
+
+					if (clockGenerator_loadConfig() != XST_SUCCESS)	{
+						xil_printf("[SI5338] Failed to load clock generator config\n\r");
+						break;
+					}
+
+					if (clockGenerator_enableAll() != XST_SUCCESS) {
+						xil_printf("[SI5338] Channels enable failed\n\r");
+						break;
+					}
+
+					xil_printf("[SI5338] Clock generator configured successfully\n\r");
+					xil_printf("[SI5338] done!\n\r");
+
 					FsblStage = XFSBL_STAGE2;
 				}
 			}break;
